# ==================== MalogBot v2.0 Environment Configuration ====================
# Copy this file to .env and fill in your values

# ==================== Flask Configuration ====================
SECRET_KEY=your-secret-key-change-me-in-production
FLASK_DEBUG=False
APP_PORT=5000

# ==================== Database Configuration ====================
POSTGRES_USER=malog
POSTGRES_PASSWORD=malogbot123
POSTGRES_DB=malogbot
POSTGRES_PORT=5433

# ==================== Redis Configuration ====================
REDIS_PORT=6379

# ==================== LLM Configuration ====================
# Required: Get your API key from https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat

# ==================== Embedding Configuration (Alibaba Cloud) ====================
# Required for RAG: Get your API key from https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your-dashscope-api-key
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
RERANK_MODEL=qwen3-vl-rerank

# ==================== RAG Configuration ====================
RAG_TOP_N=10
RAG_TOP_K=3
ENABLE_HYBRID_SEARCH=true
BM25_WEIGHT=0.3
VECTOR_WEIGHT=0.7
ENABLE_MMR=true
MMR_ALPHA=0.7

# ==================== RAG Query Optimization ====================
ENABLE_ENHANCED_RAG=true
QUERY_OPT_ENABLE_COREFERENCE=true    # 指代消解
QUERY_OPT_ENABLE_STEP_BACK=true      # Step-Back 抽象
QUERY_OPT_ENABLE_DECOMPOSITION=true  # 问题分解
QUERY_OPT_ENABLE_MULTI_QUERY=true    # 多查询重写
QUERY_OPT_MAX_SUB_QUESTIONS=5        # 最大子问题数
QUERY_OPT_MAX_VARIANTS=3             # 每子问题最大查询变体数

# ==================== Bootstrap Configuration ====================
BOOTSTRAP_KNOWLEDGE_BUDGET=8000
BOOTSTRAP_MEMORY_BUDGET=4000
BOOTSTRAP_QUALITY_THRESHOLD=0.3

# ==================== Memory Configuration ====================
ENABLE_LONG_TERM_MEMORY=true
MEMORY_TOKEN_BUDGET=2000
MEMORY_RELEVANCE_THRESHOLD=0.65
MAX_CONTEXT_TOKENS=128000

# ==================== Context Compression Configuration ====================
COMPACT_THRESHOLD_RATIO=0.8
KEEP_RECENT_MESSAGES=10
KEEP_RECENT_TOOL_RESULTS=3

# ==================== Agent Configuration ====================
BASH_TIMEOUT=30
SUB_AGENT_DEFAULT_MODE=default    # default: 同进程 | fork: 独立进程
SUB_AGENT_FORK_TIMEOUT=300        # fork模式超时（秒）
SUB_AGENT_RECURSION_LIMIT=50      # 递归限制

# ==================== MCP Configuration ====================
MCP_ENABLED=true

# ==================== Web Search Configuration (Optional) ====================
# Get your API key from Baidu Cloud
BAIDU_MCP_API_KEY=your-baidu-api-key
BAIDU_MCP_URL=https://qianfan.baidubce.com/v2/tools/web-search/mcp
WEB_SEARCH_ENABLED=false

# ==================== LangSmith Tracing (Optional) ====================
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=MalogBot

# ==================== Monitoring Configuration ====================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123
